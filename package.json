{
  "name": "kamai",
  "version": "0.1.0",
  "private": true,
  "description": "The agent that pays its own bills. x402 on Hedera, inference on 0G, identity and policy on ENSv2.",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "apps/kamai",
    "apps/customers",
    "apps/dashboard"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/dashboard/tsconfig.json",
    "kamai": "npm run dev -w apps/kamai",
    "customers": "npm run dev -w apps/customers",
    "dashboard": "npm run dev -w apps/dashboard",
    "gen-keys": "tsx scripts/gen-keys.ts",
    "setup-hedera": "tsx scripts/setup-hedera.ts",
    "create-topic": "tsx scripts/create-topic.ts",
    "setup-0g": "tsx scripts/setup-0g.ts",
    "ens-publish": "tsx scripts/ens-publish.ts",
    "ens-delegate": "tsx scripts/ens-delegate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.85.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "viem": "^2.21.0"
  }
}
